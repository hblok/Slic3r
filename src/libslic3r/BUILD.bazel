load("@rules_cc//cc:cc_library.bzl", "cc_library")

# One target per file, or per group of files that need each other (plan/bazel.md).
package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "exception",
    hdrs = ["Exception.hpp"],
    includes = ["."],
)

cc_library(
    name = "log",
    srcs = ["Log.cpp"],
    hdrs = ["Log.hpp"],
    includes = ["."],
    deps = [
        "@boost.algorithm",
        "@boost.locale",
    ],
)
