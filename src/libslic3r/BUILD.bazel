load("@rules_cc//cc:cc_library.bzl", "cc_library")

# One target per file, or per group of files that need each other (plan/bazel.md).
package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "exception",
    hdrs = ["Exception.hpp"],
    includes = ["."],
)

cc_library(
    name = "log",
    srcs = ["Log.cpp"],
    hdrs = ["Log.hpp"],
    includes = ["."],
    deps = [
        "@boost.algorithm",
        "@boost.locale",
    ],
)

cc_library(
    name = "conditional_gcode",
    srcs = ["ConditionalGCode.cpp"],
    hdrs = ["ConditionalGCode.hpp"],
    includes = ["."],
    deps = ["//src/third_party:exprtk"],
)

# libslic3r.h: constants, types and thread helpers that nearly everything includes.
# CONFESS() needs :utils to link.
cc_library(
    name = "libslic3r_header",
    hdrs = ["libslic3r.h"],
    includes = ["."],
    deps = [
        "@boost.function",
        "@boost.thread",
    ],
)

cc_library(
    name = "layer_height_spline",
    srcs = ["LayerHeightSpline.cpp"],
    hdrs = ["LayerHeightSpline.hpp"],
    includes = ["."],
    deps = [
        ":libslic3r_header",
        "//src/third_party:bspline",
    ],
)

cc_library(
    name = "utils",
    srcs = ["utils.cpp"],
    hdrs = ["utils.hpp"],
    includes = ["."],
    deps = [
        ":libslic3r_header",
        ":log",
        "@boost.system",
    ],
)

cc_library(
    name = "gcode_sender",
    srcs = ["GCodeSender.cpp"],
    hdrs = ["GCodeSender.hpp"],
    includes = ["."],
    deps = [
        ":libslic3r_header",
        "@boost.algorithm",
        "@boost.asio",
        "@boost.bind",
        "@boost.core",
        "@boost.date_time",
        "@boost.lexical_cast",
        "@boost.thread",
    ],
)

cc_library(
    name = "miniz_extension",
    srcs = ["miniz_extension.cpp"],
    hdrs = ["miniz_extension.hpp"],
    includes = ["."],
    deps = [
        ":exception",
        "//src/third_party:miniz",
    ],
)

# These files need each other in a circle, so they are one target.
