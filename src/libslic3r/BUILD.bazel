        "Line.cpp",
        "MultiPoint.cpp",
        "Point.cpp",
        "Polygon.cpp",
        "Polyline.cpp",
        "PolylineCollection.cpp",
        "SVG.cpp",
        "Surface.cpp",
        "TransformationMatrix.cpp",
        "TriangleMesh.cpp",
    ],
    hdrs = [
        "BoundingBox.hpp",
        "ClipperUtils.hpp",
        "ExPolygon.hpp",
        "ExPolygonCollection.hpp",
        "Geometry.hpp",
        "Line.hpp",
        "MultiPoint.hpp",
        "Point.hpp",
        "Polygon.hpp",
        "Polyline.hpp",
        "PolylineCollection.hpp",
        "SVG.hpp",
        "Surface.hpp",
        "TransformationMatrix.hpp",
        "TriangleMesh.hpp",
