load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Libraries from other projects, built without warnings. Include paths start here.
package(default_visibility = ["//src:__subpackages__"])

cc_library(
    name = "exprtk",
    hdrs = ["exprtk/exprtk.hpp"],
    includes = ["."],
)

cc_library(
    name = "bspline",
    srcs = ["BSpline/BSpline.cpp"],
    hdrs = [
        "BSpline/BSpline.h",
        "BSpline/BandedMatrix.h",
    ],
    copts = ["-w"],
    includes = ["."],
)

cc_library(
    name = "miniz",
    srcs = ["miniz/miniz.c"],
    hdrs = ["miniz/miniz.h"],
    copts = ["-w"],
    includes = ["."],
)

cc_library(
    name = "admesh",
    srcs = [
        "admesh/connect.c",
        "admesh/normals.c",
        "admesh/shared.c",
        "admesh/stl_io.c",
        "admesh/stlinit.c",
        "admesh/util.c",
    ],
    hdrs = [
        "admesh/portable_endian.h",
        "admesh/stl.h",
    ],
    copts = [
        "-std=gnu99",
        "-w",
    ],
    includes = [
        ".",
        "admesh",
    ],
    deps = ["//src/standalone:config"],
)

cc_library(
    name = "clipper",
    srcs = ["clipper.cpp"],
    hdrs = ["clipper.hpp"],
    copts = ["-w"],
    includes = ["."],
)

cc_library(
    name = "polypartition",
    srcs = ["polypartition.cpp"],
    hdrs = ["polypartition.h"],
    copts = ["-w"],
    includes = ["."],
)

cc_library(
    name = "poly2tri",
    srcs = glob([
        "poly2tri/common/*.cc",
        "poly2tri/sweep/*.cc",
    ]),
    hdrs = glob([
        "poly2tri/*.h",
        "poly2tri/common/*.h",
        "poly2tri/sweep/*.h",
    ]),
    copts = ["-w"],
    includes = ["."],
)

cc_library(
    name = "expat",
    srcs = [
        "expat/xmlparse.c",
        "expat/xmlrole.c",
        "expat/xmltok.c",
    ],
    hdrs = glob([
        "expat/*.h",
        "expat/*.inc",
    ]),
    copts = ["-w"],
    includes = [
        ".",
        "expat",
    ],
)

cc_library(
    name = "tiny_obj_loader",
    hdrs = ["tiny_obj_loader.h"],
    includes = ["."],
)

cc_library(
    name = "zip_archive",
    srcs = ["Zip/ZipArchive.cpp"],
    hdrs = ["Zip/ZipArchive.hpp"],
    copts = ["-w"],
    includes = ["."],
    deps = [":miniz"],
)
