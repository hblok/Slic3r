load("@rules_cc//cc:cc_test.bzl", "cc_test")

# A test depends on the target it tests (and Google Test) only. The test_*.cpp files here
# are the Catch tests of the CMake build; they go as their cases are ported.

cc_test(
    name = "exception_test",
    size = "small",
    srcs = ["exception_test.cpp"],
    deps = [
        "//src/libslic3r:exception",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "log_test",
    size = "small",
    srcs = ["log_test.cpp"],
    deps = [
        "//src/libslic3r:log",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "conditional_gcode_test",
    size = "small",
    srcs = ["conditional_gcode_test.cpp"],
    deps = [
        "//src/libslic3r:conditional_gcode",
        "@googletest//:gtest_main",
    ],
)
