load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Keep this one: it shows that Bazel can build, run and judge a C++ test here, and
# nothing else. If it fails, the setup is broken, not Slic3r.
cc_test(
    name = "minimal_test",
    size = "small",
    srcs = ["minimal_test.cpp"],
    deps = ["@googletest//:gtest_main"],
)

# models and configuration files the tests read, found at src/test/inputs/
filegroup(
    name = "inputs",
    srcs = glob(["inputs/**"]),
    visibility = ["//src:__subpackages__"],
)
