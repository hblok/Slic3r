load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Keep this one: it shows that Bazel can build, run and judge a C++ test here, and
# nothing else. If it fails, the setup is broken, not Slic3r.
cc_test(
    name = "minimal_test",
    size = "small",
    srcs = ["minimal_test.cpp"],
    deps = ["@googletest//:gtest_main"],
)

# models and configuration files the tests read, found at src/test/inputs/
filegroup(
    name = "inputs",
    srcs = glob(["inputs/**"]),
    visibility = [
        "//src:__subpackages__",
        "//utils:__pkg__",
    ],
)

# the test meshes and "slice this" helpers of the tests that need whole prints
cc_library(
    name = "print_test_data",
    testonly = True,
    srcs = ["test_data.cpp"],
    hdrs = ["test_data.hpp"],
    includes = ["."],
    visibility = ["//src:__subpackages__"],
    deps = ["//src/libslic3r:slicing_core"],
)

cc_test(
    name = "command_line_test",
    size = "small",
    srcs = ["command_line_test.cpp"],
    data = [":inputs"],
    deps = [
        "//src:command_line",
        "//src/libslic3r:gcode_reader",
        "@googletest//:gtest_main",
    ],
)
