load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The GUI. Every header is in :headers, so that a target needs another only where it
# uses its code; then nearly every file is a target of its own. (plan/bazel.md)
package(
    default_visibility = ["//src:__subpackages__"],
)

cc_library(
    name = "headers",
    tags = ["gui"],
    hdrs = glob(["**/*.hpp"]),
    includes = ["."],
    deps = [
        "//bazel:opengl",
        "@wxwidgets",
        "//src/libslic3r:config",
        "//src/libslic3r:config_base",
        "//src/libslic3r:gcode_sender",
        "//src/libslic3r:geometry",
        "//src/libslic3r:layer_height_spline",
        "//src/libslic3r:libslic3r_header",
        "//src/libslic3r:log",
        "//src/libslic3r:print_config",
        "//src/libslic3r:sla_print",
        "//src/libslic3r:slicing_core",
    ],
)

cc_library(
    name = "about_dialog",
    tags = ["gui"],
    srcs = ["Dialogs/AboutDialog.cpp"],
    deps = [
        ":headers",
        ":misc_ui",
    ],
)

